FROM harbor.vimpelcom.ru/common/nginx-uno

COPY /nginx/  /etc/nginx/
COPY /scripts/99-replace-www-env.sh /docker-entrypoint.d/99-replace-www-env.sh
COPY /build/  /www/
RUN chown -R nginx:root /www && chmod o+r /www -R && chmod +x /docker-entrypoint.d/99-replace-www-env.sh
USER nginx

