        "history": "5.3.0",
        "lodash": "4.17.21",
        "oidc-client-ts": "3.4.1",
        "panzoom": "9.4.2",
        "re-resizable": "6.9.9",
        "react": "18.2.0",
        "react-bpmn": "^0.2.0",
        "react-dom": "18.2.0",
        "react-force-graph-2d": "1.29.1",
        "react-hook-form": "7.45.1",
        "react-markdown": "10.1.0",
        "react-popper": "2.3.0",
        "react-router-dom": "6.3.0",
        "react-spring": "9.5.2",
