        "html-loader": "3.1.0",
        "html-webpack-plugin": "5.5.0",
        "husky": "4.3.8",
        "mini-css-extract-plugin": "2.6.0",
        "path": "0.12.7",
        "prettier": "2.7.0",
        "style-loader": "3.3.1",
