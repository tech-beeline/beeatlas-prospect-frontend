        "@emotion/babel-plugin": "11.9.2",
        "@svgr/webpack": "6.2.1",
        "@types/d3": "7.4.0",
        "@types/dompurify": "2.4.0",
        "@typescript-eslint/eslint-plugin": "5.28.0",
        "@typescript-eslint/parser": "5.28.0",
        "@webpack-cli/serve": "1.7.0",
        "babel-loader": "8.2.5",
        "clean-webpack-plugin": "4.0.0",
        "copy-webpack-plugin": "11.0.0",
        "core-js": "3.23.1",
        "cross-env": "7.0.3",
        "css-loader": "6.7.1",
        "eslint": "8.17.0",
